{
  "layer": "top",
  "position": "top",
  "height": 64,
  "spacing": 10,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["custom/steam", "custom/launcher", "custom/cpu-temp", "custom/gpu-temp", "custom/fan", "custom/tdp"],
  "modules-center": ["clock"],
  "modules-right": ["backlight", "pulseaudio", "network", "bluetooth", "battery"],
  "custom/steam": {
    "format": "Steam",
    "on-click": "steam -bigpicture",
    "tooltip": false,
    "interval": "once",
  },
  "custom/launcher": {
    "format": "Apps",
    "on-click": "lua ~/.config/hypr/config/handheld/launcher.lua",
    "tooltip": false,
    "interval": "once",
  },
  "custom/cpu-temp": {
    "exec": "lua ~/.config/hypr/scripts/read-sensor.lua cpu",
    "interval": 5,
    "tooltip": false,
  },
  "custom/gpu-temp": {
    "exec": "lua ~/.config/hypr/scripts/read-sensor.lua gpu",
    "interval": 5,
    "tooltip": false,
  },
  "custom/fan": {
    "exec": "lua ~/.config/hypr/scripts/read-sensor.lua fan",
    "interval": 5,
    "tooltip": false,
  },
  "custom/tdp": {
    "exec": "lua ~/.config/hypr/scripts/read-sensor.lua tdp",
    "on-click": "lua ~/.config/hypr/scripts/read-sensor.lua tdp cycle",
    "interval": 30,
    "tooltip": false,
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +5%",
    "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 5%-",
    "on-click": "brightnessctl -d amdgpu_bl1 set 50%",
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "Eth",
    "format-disconnected": "No Net",
    "tooltip": false,
    "on-click": "nmcli connection show",
  },
  "bluetooth": {
    "format": "{status}",
    "format-connected": "{num_connections}",
    "format-disabled": "Off",
    "tooltip": false,
    "on-click": "bluetoothctl scan on",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}%",
    "format-charging": "Chg {capacity}%",
    "format-plugged": "{capacity}%",
    "tooltip": false,
  },
}
