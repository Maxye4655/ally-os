[Unit]
Description=Adaptive Hyprland profile switcher (handheld/desktop)
Documentation=file://%h/.config/hypr/README.md
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/lua %h/.config/hypr/scripts/detect-mode.lua --watch
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
